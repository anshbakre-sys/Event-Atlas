# Server and Environment Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# MongoDB Database URI (MongoDB Atlas or local MongoDB instance)
# Mongoose connects to this URI; falls back gracefully to in-memory verified catalog if not provided
MONGODB_URI="mongodb://localhost:27017/eventatlas"

# Google Gemini API Key
# Automatically injected by Google AI Studio from Secrets panel. Used exclusively on the server side.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Session and Auth Secrets
SESSION_SECRET="event-atlas-super-secret-key-change-in-production"

# External Provider Integration Placeholders (Optional)
# When provided, external adapters will synchronize live feeds directly from authorized provider endpoints.
DISTRICT_API_KEY=""
BOOKMYSHOW_API_KEY=""
LUMA_API_KEY=""
